let newsData = [];
let favorites = [];

// Inicialización
window.addEventListener('DOMContentLoaded', () => {
    const storedNews = localStorage.getItem('mundo_animal_news');
    newsData = storedNews ? JSON.parse(storedNews) : initialNewsData;

    const storedFavs = localStorage.getItem('mundo_animal_favs');
    favorites = storedFavs ? JSON.parse(storedFavs) : [];

    updateFavBadge();
    renderHomeCarousel();
    renderNewsTab();
    renderAdoptionCards();
    renderFavoritesView();
    renderCrudTable();
});

// Navegación entre vistas
function switchTab(tabName) {
    const views = ['home', 'noticias', 'favoritos', 'adopcion', 'contacto', 'crud'];
    views.forEach(v => {
        const el = document.getElementById(`view-${v}`);
        if (el) el.classList.add('hidden');
        const navBtn = document.getElementById(`nav-${v}`);
        if (navBtn) navBtn.classList.remove('active');
    });

    const activeView = document.getElementById(`view-${tabName}`);
    if (activeView) activeView.classList.remove('hidden');

    const activeNav = document.getElementById(`nav-${tabName}`);
    if (activeNav) activeNav.classList.add('active');

    window.scrollTo({ top: 0, behavior: 'smooth' });
}

// Carrusel Home
function renderHomeCarousel() {
    const track = document.getElementById('carousel-track');
    if (!track) return;

    track.innerHTML = newsData.slice(0, 3).map(item => `
        <div class="vintage-frame p-3 rounded bg-[#ebdcc4] flex flex-col justify-between h-full">
            <h3 class="title-vintage text-center text-lg font-bold text-amber-950 mb-2 border-b border-amber-950/30 pb-1">
                ${item.title}
            </h3>
            <div class="w-full h-48 overflow-hidden mb-3 border border-amber-900/40">
                <img src="${item.image}" alt="${item.title}" class="w-full h-full object-cover">
            </div>
            <p class="text-xs text-amber-900 line-clamp-2 mb-3">${item.subtitle || item.summary}</p>
            <div class="flex justify-between items-center pt-2 border-t border-amber-900/20">
                <button onclick="openNewsDetail('${item.id}')" class="text-xs font-serif font-bold text-amber-950 hover:underline">Ver más &rarr;</button>
                <button onclick="toggleFavorite('${item.id}')" class="text-xs text-amber-900 hover:text-amber-950">
                    <i class="${isFavorite(item.id) ? 'fa-solid' : 'fa-regular'} fa-bookmark text-base"></i>
                </button>
            </div>
        </div>
    `).join('');
}

function moveCarousel(direction) {
    if (direction === 1) {
        const first = newsData.shift();
        newsData.push(first);
    } else {
        const last = newsData.pop();
        newsData.unshift(last);
    }
    renderHomeCarousel();
}

// Vista de Noticias Unificada (Mockup 2 Style)
function renderNewsTab() {
    const container = document.getElementById('noticias-container');
    const filter = document.getElementById('filter-category').value;
    if (!container) return;

    let filtered = newsData;
    if (filter !== 'todos') {
        filtered = newsData.filter(n => n.category === filter);
    }

    if (filtered.length === 0) {
        container.innerHTML = `<p class="text-center text-amber-900 py-8 font-serif">No hay noticias en esta categoría.</p>`;
        return;
    }

    container.innerHTML = filtered.map(item => `
        <div class="flex flex-col sm:flex-row gap-4 p-3 bg-amber-900/5 rounded border border-amber-900/20">
            <div class="purple-frame w-full sm:w-44 h-36 flex-shrink-0 overflow-hidden">
                <img src="${item.image}" alt="${item.title}" class="w-full h-full object-cover">
            </div>
            <div class="flex-1 flex flex-col justify-between">
                <div>
                    <div class="flex justify-between items-start">
                        <h3 class="title-vintage text-xl font-bold text-amber-950">${item.title}: ${item.subtitle || ''}</h3>
                        <span class="text-xs bg-amber-950/10 px-2 py-0.5 rounded text-amber-900 font-mono">${item.category}</span>
                    </div>
                    <p class="font-serif text-sm text-amber-900/90 my-2 leading-snug">${item.summary}</p>
                </div>
                <div class="flex items-center justify-between pt-2 border-t border-amber-900/10">
                    <span class="text-xs text-amber-900/70 font-mono">${item.date}</span>
                    <div class="space-x-3">
                        <button onclick="toggleFavorite('${item.id}')" class="text-sm text-amber-950">
                            <i class="${isFavorite(item.id) ? 'fa-solid' : 'fa-regular'} fa-star text-amber-800"></i>
                            <span class="text-xs">${isFavorite(item.id) ? 'Guardado' : 'Favorito'}</span>
                        </button>
                        <button onclick="openNewsDetail('${item.id}')" class="bg-amber-950 text-amber-100 text-xs px-3 py-1 rounded">Leer Detalle</button>
                    </div>
                </div>
            </div>
        </div>
    `).join('');
}

